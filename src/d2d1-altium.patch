+    d2d_outline_sink_EndFigure,
+    d2d_outline_sink_Close,
+};
+
+static unsigned int d2d_outline_cache_hash(IDWriteFontFace *font_face, UINT16 glyph, BOOL sideways)
+{
+    UINT_PTR h = (UINT_PTR)font_face;
+
+    h = (h >> 4) * 2654435761u ^ glyph * 40503u ^ sideways;
+    return (unsigned int)(h ^ (h >> 16));
+}
+
+/* Returns a cached outline; outlines are never freed while the cache is below its limit, and the
+ * cache is only cleared under the lock while no lookup is using its result (lookups copy nothing,
+ * so the lock is held by the caller for the whole rasterization). */
+static const struct d2d_glyph_outline *d2d_outline_cache_get(IDWriteFontFace *font_face, UINT16 glyph, BOOL sideways)
+{
+    unsigned int hash = d2d_outline_cache_hash(font_face, glyph, sideways), i;
+    struct d2d_outline_sink sink = {{&d2d_outline_sink_vtbl}};
+    struct d2d_glyph_outline *o, *next;
+    HRESULT hr;
+
+    for (o = d2d_outline_cache[hash % D2D_OUTLINE_CACHE_BUCKETS]; o; o = o->next)
+    {
+        if (o->font_face == font_face && o->glyph == glyph && o->sideways == sideways)
+            return o;
+    }
+
+    if (d2d_outline_cache_count >= D2D_OUTLINE_CACHE_MAX_ENTRIES)
+    {
+        for (i = 0; i < D2D_OUTLINE_CACHE_BUCKETS; ++i)
+        {
+            for (o = d2d_outline_cache[i]; o; o = next)
+            {
+                next = o->next;
+                IDWriteFontFace_Release(o->font_face);
+                free(o->ops);
+                free(o);
+            }
+            d2d_outline_cache[i] = NULL;
+        }
+        d2d_outline_cache_count = 0;
+    }
+
+    hr = IDWriteFontFace_GetGlyphRunOutline(font_face, D2D_OUTLINE_REF_EM, &glyph, NULL, NULL, 1,
+            sideways, FALSE, &sink.IDWriteGeometrySink_iface);
+    if (FAILED(hr) || sink.failed || !(o = calloc(1, sizeof(*o))))
+    {
+        free(sink.ops);
+        return NULL;
+    }
+    o->font_face = font_face;
+    IDWriteFontFace_AddRef(font_face);
+    o->glyph = glyph;
+    o->sideways = sideways;
+    o->op_count = sink.count;
+    o->ops = sink.ops;
+    o->next = d2d_outline_cache[hash % D2D_OUTLINE_CACHE_BUCKETS];
+    d2d_outline_cache[hash % D2D_OUTLINE_CACHE_BUCKETS] = o;
+    ++d2d_outline_cache_count;
+    return o;
+}
+
+struct d2d_raster
+{
+    float *acc;
+    int w, h;
+};
+
+/* Signed-area coverage accumulation (as in font-rs). */
+static void d2d_raster_line(struct d2d_raster *r, D2D1_POINT_2F p0, D2D1_POINT_2F p1)
+{
+    float dir, dxdy, x;
+    int y, y0, y1;
+
+    if (fabsf(p0.y - p1.y) <= 1e-6f)
+        return;
+    if (p0.y < p1.y)
+    {
+        dir = 1.0f;
+    }
+    else
+    {
+        D2D1_POINT_2F t = p0;
+        p0 = p1;
+        p1 = t;
+        dir = -1.0f;
+    }
+    dxdy = (p1.x - p0.x) / (p1.y - p0.y);
+    x = p0.x;
+    if (p0.y < 0.0f)
+        x -= p0.y * dxdy;
+    y0 = p0.y < 0.0f ? 0 : (int)p0.y;
+    y1 = min(r->h, (int)ceilf(p1.y));
+
+    for (y = y0; y < y1; ++y)
+    {
+        float *line = r->acc + (size_t)y * r->w;
+        float dy = min((float)(y + 1), p1.y) - max((float)y, p0.y);
+        float xnext = x + dxdy * dy, d = dy * dir;
+        float xa = min(x, xnext), xb = max(x, xnext);
+        float xa_floor = floorf(xa), xb_ceil = ceilf(xb);
+        int xai = (int)xa_floor, xbi = (int)xb_ceil;
+
+        if (xai < 0)
+            xai = 0;
+        if (xbi <= xai + 1)
+        {
+            float xmf = 0.5f * (x + xnext) - xa_floor;
+            line[xai] += d - d * xmf;
+            line[xai + 1] += d * xmf;
+        }
+        else
+        {
+            float s = 1.0f / (xb - xa);
+            float xaf = xa - xa_floor;
+            float a0 = 0.5f * s * (1.0f - xaf) * (1.0f - xaf);
+            float xbf = xb - xb_ceil + 1.0f;
+            float am = 0.5f * s * xbf * xbf;
+            int xi;
+
+            line[xai] += d * a0;
+            if (xbi == xai + 2)
+            {
+                line[xai + 1] += d * (1.0f - a0 - am);
+            }
+            else
+            {
+                float a1 = s * (1.5f - xaf), a2;
+
+                line[xai + 1] += d * (a1 - a0);
+                for (xi = xai + 2; xi < xbi - 1; ++xi)
+                    line[xi] += d * s;
+                a2 = a1 + (xbi - xai - 3) * s;
+                line[xbi - 1] += d * (1.0f - a2 - am);
+            }
+            line[xbi] += d * am;
+        }
+        x = xnext;
+    }
+}
+
+struct d2d_flat_path
+{
+    D2D1_POINT_2F *points;
+    size_t count, size;
+    float min_x, min_y, max_x, max_y;
+    BOOL failed;
+};
+
+static void d2d_flat_path_add(struct d2d_flat_path *path, D2D1_POINT_2F p)
+{
+    if (path->failed)
+        return;
+    if (!d2d_array_reserve((void **)&path->points, &path->size, path->count + 1, sizeof(*path->points)))
+    {
+        path->failed = TRUE;
+        return;
+    }
+    path->points[path->count++] = p;
+    path->min_x = min(path->min_x, p.x);
+    path->min_y = min(path->min_y, p.y);
+    path->max_x = max(path->max_x, p.x);
+    path->max_y = max(path->max_y, p.y);
+}
+
+/* Marks the end of a closed figure in the flattened point list. */
+static const D2D1_POINT_2F d2d_flat_path_break = {INFINITY, INFINITY};
+
+static void d2d_flat_path_end_figure(struct d2d_flat_path *path)
+{
+    if (path->failed)
+        return;
+    if (!d2d_array_reserve((void **)&path->points, &path->size, path->count + 1, sizeof(*path->points)))
+    {
+        path->failed = TRUE;
+        return;
+    }
+    path->points[path->count++] = d2d_flat_path_break;
+}
+
+static inline D2D1_POINT_2F d2d_outline_transform(const D2D1_MATRIX_3X2_F *m, float x, float y)
+{
+    D2D1_POINT_2F p;
+
+    p.x = x * m->_11 + y * m->_21 + m->_31;
+    p.y = x * m->_12 + y * m->_22 + m->_32;
+    return p;
+}
+
+static void d2d_flatten_glyph(struct d2d_flat_path *path, const struct d2d_glyph_outline *o,
+        const D2D1_MATRIX_3X2_F *m)
+{
+    D2D1_POINT_2F cur = {0.0f, 0.0f}, c1, c2, c3, p;
+    BOOL open = FALSE;
+    size_t i;
+
+    for (i = 0; i < o->op_count; ++i)
+    {
+        const struct d2d_outline_op *op = &o->ops[i];
+
+        switch (op->type)
+        {
+            case D2D_OUTLINE_MOVE:
+                if (open)
+                    d2d_flat_path_end_figure(path);
+                cur = d2d_outline_transform(m, op->p[0].x, op->p[0].y);
+                d2d_flat_path_add(path, cur);
+                open = TRUE;
+                break;
+
+            case D2D_OUTLINE_LINE:
+                cur = d2d_outline_transform(m, op->p[0].x, op->p[0].y);
+                d2d_flat_path_add(path, cur);
+                break;
+
+            case D2D_OUTLINE_CUBIC:
+            {
+                float ddx1, ddy1, ddx2, ddy2, dd, t;
+                int n, k;
+
+                c1 = d2d_outline_transform(m, op->p[0].x, op->p[0].y);
+                c2 = d2d_outline_transform(m, op->p[1].x, op->p[1].y);
+                c3 = d2d_outline_transform(m, op->p[2].x, op->p[2].y);
+                /* Wang's formula, 0.2 px tolerance. */
+                ddx1 = cur.x - 2.0f * c1.x + c2.x;
+                ddy1 = cur.y - 2.0f * c1.y + c2.y;
+                ddx2 = c1.x - 2.0f * c2.x + c3.x;
+                ddy2 = c1.y - 2.0f * c2.y + c3.y;
+                dd = sqrtf(max(ddx1 * ddx1 + ddy1 * ddy1, ddx2 * ddx2 + ddy2 * ddy2));
+                n = (int)ceilf(sqrtf(0.75f * dd / 0.2f));
+                n = max(1, min(n, 64));
+                for (k = 1; k <= n; ++k)
+                {
+                    float u, a, b, c, d;
+
+                    t = (float)k / n;
+                    u = 1.0f - t;
+                    a = u * u * u;
+                    b = 3.0f * u * u * t;
+                    c = 3.0f * u * t * t;
+                    d = t * t * t;
+                    p.x = a * cur.x + b * c1.x + c * c2.x + d * c3.x;
+                    p.y = a * cur.y + b * c1.y + c * c2.y + d * c3.y;
+                    d2d_flat_path_add(path, p);
+                }
+                cur = c3;
+                break;
+            }
+        }
+    }
+    if (open)
+        d2d_flat_path_end_figure(path);
+}
+
+/* Rasterizes a glyph run into an 8-bit alpha buffer. Returns FALSE if the run can't be handled here,
+ * in which case the caller falls back to dwrite. On success with an empty run, *values is NULL. */
+static BOOL d2d_rasterize_glyph_run(const DWRITE_GLYPH_RUN *run, D2D1_POINT_2F baseline_origin,
+        const D2D1_MATRIX_3X2_F *device_m, DWRITE_MEASURING_MODE measuring_mode,
+        BYTE **values, RECT *bounds)
+{
+    struct d2d_flat_path path = {NULL, 0, 0, INFINITY, INFINITY, -INFINITY, -INFINITY, FALSE};
+    float scale = run->fontEmSize / D2D_OUTLINE_REF_EM, pen = 0.0f, acc_sum;
+    DWRITE_FONT_METRICS font_metrics;
+    struct d2d_raster raster;
+    BOOL ret = FALSE;
+    UINT32 i;
+    int x, y;
+
+    *values = NULL;
+    if (run->isSideways || (run->bidiLevel & 1) || !run->glyphCount)
+        return FALSE;
+    if (!run->glyphAdvances && measuring_mode != DWRITE_MEASURING_MODE_NATURAL)
+        return FALSE;
+
+    if (!run->glyphAdvances)
+        IDWriteFontFace_GetMetrics(run->fontFace, &font_metrics);
+
+    EnterCriticalSection(&d2d_outline_cache_cs);
+    for (i = 0; i < run->glyphCount; ++i)
+    {
+        const struct d2d_glyph_outline *o;
+        D2D1_MATRIX_3X2_F gm;
+        float gx = baseline_origin.x + pen, gy = baseline_origin.y, advance;
+
+        if (run->glyphOffsets)
+        {
+            gx += run->glyphOffsets[i].advanceOffset;
+            gy -= run->glyphOffsets[i].ascenderOffset;
+        }
+
+        if (!(o = d2d_outline_cache_get(run->fontFace, run->glyphIndices[i], FALSE)))
+            goto done;
+
+        /* glyph space -> run space -> device space */
+        gm._11 = scale * device_m->_11;
+        gm._12 = scale * device_m->_12;
+        gm._21 = scale * device_m->_21;
+        gm._22 = scale * device_m->_22;
+        gm._31 = gx * device_m->_11 + gy * device_m->_21 + device_m->_31;
+        gm._32 = gx * device_m->_12 + gy * device_m->_22 + device_m->_32;
+        d2d_flatten_glyph(&path, o, &gm);
+        if (path.failed)
+            goto done;
+
+        if (run->glyphAdvances)
+        {
+            advance = run->glyphAdvances[i];
+        }
+        else
+        {
+            DWRITE_GLYPH_METRICS gmetrics;
+
+            if (FAILED(IDWriteFontFace_GetDesignGlyphMetrics(run->fontFace, &run->glyphIndices[i], 1,
+                    &gmetrics, FALSE)))
+                goto done;
+            advance = gmetrics.advanceWidth * run->fontEmSize / font_metrics.designUnitsPerEm;
+        }
+        pen += advance;
+    }
+    LeaveCriticalSection(&d2d_outline_cache_cs);
+
+    if (!path.count || path.min_x > path.max_x)
+    {
+        SetRectEmpty(bounds);
+        free(path.points);
+        return TRUE;
+    }
+
+    bounds->left = (int)floorf(path.min_x);
+    bounds->top = (int)floorf(path.min_y);
+    bounds->right = (int)ceilf(path.max_x) + 1;
+    bounds->bottom = (int)ceilf(path.max_y) + 1;
+    raster.w = bounds->right - bounds->left;
+    raster.h = bounds->bottom - bounds->top;
+    if (raster.w <= 0 || raster.h <= 0 || (size_t)raster.w * raster.h > 64 * 1024 * 1024)
+    {
+        free(path.points);
+        return FALSE;
+    }
+
+    if (!(raster.acc = calloc((size_t)raster.w * raster.h + raster.w + 2, sizeof(*raster.acc))))
+    {
+        free(path.points);
+        return FALSE;
+    }
+
+    {
+        D2D1_POINT_2F start, prev, p;
+        BOOL have_start = FALSE;
+        size_t k;
+
+        for (k = 0; k < path.count; ++k)
+        {
+            p = path.points[k];
+            if (isinf(p.x))
+            {
+                if (have_start)
+                    d2d_raster_line(&raster, prev, start);
+                have_start = FALSE;
+                continue;
+            }
+            p.x -= bounds->left;
+            p.y -= bounds->top;
+            if (!have_start)
+            {
+                start = prev = p;
+                have_start = TRUE;
+                continue;
+            }
+            d2d_raster_line(&raster, prev, p);
+            prev = p;
+        }
+    }
+    free(path.points);
+
+    if (!(*values = malloc((size_t)raster.w * raster.h)))
+    {
+        free(raster.acc);
+        return FALSE;
+    }
+    acc_sum = 0.0f;
+    for (y = 0; y < raster.h; ++y)
+    {
+        for (x = 0; x < raster.w; ++x)
+        {
+            float a;
+
+            acc_sum += raster.acc[(size_t)y * raster.w + x];
+            a = min(fabsf(acc_sum), 1.0f);
+            (*values)[(size_t)y * raster.w + x] = (BYTE)(a * 255.0f + 0.5f);
+        }
+    }
+    free(raster.acc);
+    return TRUE;
+
+done:
+    LeaveCriticalSection(&d2d_outline_cache_cs);
+    free(path.points);
+    return ret;
+}
+
+/* Cache of rendered glyph-run alpha bitmaps. Redrawing the same text at the same scale (e.g. while
+ * panning) reuses the bitmap instead of re-rasterizing every glyph through dwrite/FreeType. */
+#define D2D_GLYPH_CACHE_BUCKETS 4096
+#define D2D_GLYPH_CACHE_MAX_ENTRIES 32768
+
+struct d2d_glyph_cache_entry
+{
+    struct d2d_glyph_cache_entry *next;
+    unsigned int hash;
+    IDWriteFontFace *font_face;
+    float em_size;
+    BOOL sideways;
+    UINT32 bidi_level;
+    UINT32 count;
+    UINT16 *indices;
+    float *advances;
+    DWRITE_GLYPH_OFFSET *offsets;
+    float m[4];
+    int frac_x, frac_y;
+    DWRITE_RENDERING_MODE rendering_mode;
+    DWRITE_MEASURING_MODE measuring_mode;
+    DWRITE_TEXT_ANTIALIAS_MODE antialias_mode;
+    ID2D1Bitmap *bitmap; /* NULL for an empty run. */
+    RECT bounds; /* Relative to the integer device origin. */
+};
+
+struct d2d_glyph_cache
+{
+    struct d2d_glyph_cache_entry *buckets[D2D_GLYPH_CACHE_BUCKETS];
+    unsigned int entry_count;
+};
+
+static void d2d_glyph_cache_entry_free(struct d2d_glyph_cache_entry *e)
+{
+    if (e->bitmap)
+        ID2D1Bitmap_Release(e->bitmap);
+    IDWriteFontFace_Release(e->font_face);
+    free(e->indices);
+    free(e->advances);
+    free(e->offsets);
+    free(e);
+}
+
+static void d2d_glyph_cache_clear(struct d2d_glyph_cache *cache)
+{
+    struct d2d_glyph_cache_entry *e, *next;
+    unsigned int i;
+
+    for (i = 0; i < D2D_GLYPH_CACHE_BUCKETS; ++i)
+    {
+        for (e = cache->buckets[i]; e; e = next)
+        {
+            next = e->next;
+            d2d_glyph_cache_entry_free(e);
+        }
+        cache->buckets[i] = NULL;
+    }
+    cache->entry_count = 0;
+}
+
+void d2d_device_context_destroy_glyph_cache(struct d2d_device_context *context)
+{
+    if (!context->glyph_cache)
+        return;
+    d2d_glyph_cache_clear(context->glyph_cache);
+    free(context->glyph_cache);
+    context->glyph_cache = NULL;
+}
+
+static unsigned int d2d_hash_bytes(unsigned int h, const void *data, size_t size)
+{
+    const unsigned char *p = data;
+
+    while (size--)
+        h = (h ^ *p++) * 16777619u;
+    return h;
+}
+
+static unsigned int d2d_glyph_cache_hash(const DWRITE_GLYPH_RUN *run, const float *m, int frac_x, int frac_y,
+        DWRITE_RENDERING_MODE rendering_mode, DWRITE_MEASURING_MODE measuring_mode,
+        DWRITE_TEXT_ANTIALIAS_MODE antialias_mode)
+{
+    unsigned int h = 2166136261u;
+
+    h = d2d_hash_bytes(h, &run->fontFace, sizeof(run->fontFace));
+    h = d2d_hash_bytes(h, &run->fontEmSize, sizeof(run->fontEmSize));
+    h = d2d_hash_bytes(h, &run->glyphCount, sizeof(run->glyphCount));
+    h = d2d_hash_bytes(h, run->glyphIndices, run->glyphCount * sizeof(*run->glyphIndices));
+    if (run->glyphAdvances)
+        h = d2d_hash_bytes(h, run->glyphAdvances, run->glyphCount * sizeof(*run->glyphAdvances));
+    h = d2d_hash_bytes(h, m, 4 * sizeof(*m));
+    h = d2d_hash_bytes(h, &frac_x, sizeof(frac_x));
+    h = d2d_hash_bytes(h, &frac_y, sizeof(frac_y));
+    h = d2d_hash_bytes(h, &rendering_mode, sizeof(rendering_mode));
+    h = d2d_hash_bytes(h, &measuring_mode, sizeof(measuring_mode));
+    h = d2d_hash_bytes(h, &antialias_mode, sizeof(antialias_mode));
+    return h;
+}
+
+static BOOL d2d_glyph_cache_entry_matches(const struct d2d_glyph_cache_entry *e, unsigned int hash,
+        const DWRITE_GLYPH_RUN *run, const float *m, int frac_x, int frac_y, DWRITE_RENDERING_MODE rendering_mode,
+        DWRITE_MEASURING_MODE measuring_mode, DWRITE_TEXT_ANTIALIAS_MODE antialias_mode)
+{
+    if (e->hash != hash || e->font_face != run->fontFace || e->em_size != run->fontEmSize
+            || e->sideways != run->isSideways || e->bidi_level != run->bidiLevel || e->count != run->glyphCount
+            || memcmp(e->m, m, sizeof(e->m)) || e->frac_x != frac_x || e->frac_y != frac_y
+            || e->rendering_mode != rendering_mode || e->measuring_mode != measuring_mode
+            || e->antialias_mode != antialias_mode)
+        return FALSE;
+    if (memcmp(e->indices, run->glyphIndices, run->glyphCount * sizeof(*run->glyphIndices)))
+        return FALSE;
+    if (!e->advances != !run->glyphAdvances
+            || (run->glyphAdvances && memcmp(e->advances, run->glyphAdvances, run->glyphCount * sizeof(float))))
+        return FALSE;
+    if (!e->offsets != !run->glyphOffsets || (run->glyphOffsets
+            && memcmp(e->offsets, run->glyphOffsets, run->glyphCount * sizeof(*run->glyphOffsets))))
+        return FALSE;
+    return TRUE;
+}
+
+static void d2d_glyph_cache_add(struct d2d_device_context *context, unsigned int hash, const DWRITE_GLYPH_RUN *run,
+        const float *m, int frac_x, int frac_y, DWRITE_RENDERING_MODE rendering_mode,
+        DWRITE_MEASURING_MODE measuring_mode, DWRITE_TEXT_ANTIALIAS_MODE antialias_mode,
+        ID2D1Bitmap *bitmap, const RECT *bounds)
+{
+    struct d2d_glyph_cache *cache = context->glyph_cache;
+    struct d2d_glyph_cache_entry *e;
+    UINT32 n = run->glyphCount;
+
+    if (cache->entry_count >= D2D_GLYPH_CACHE_MAX_ENTRIES)
+        d2d_glyph_cache_clear(cache);
+
+    if (!(e = calloc(1, sizeof(*e))))
+        return;
+    if (!(e->indices = malloc(n * sizeof(*e->indices)))
+            || (run->glyphAdvances && !(e->advances = malloc(n * sizeof(*e->advances))))
+            || (run->glyphOffsets && !(e->offsets = malloc(n * sizeof(*e->offsets)))))
+    {
+        free(e->indices);
+        free(e->advances);
+        free(e->offsets);
+        free(e);
+        return;
+    }
+    memcpy(e->indices, run->glyphIndices, n * sizeof(*e->indices));
+    if (run->glyphAdvances)
+        memcpy(e->advances, run->glyphAdvances, n * sizeof(*e->advances));
+    if (run->glyphOffsets)
+        memcpy(e->offsets, run->glyphOffsets, n * sizeof(*e->offsets));
+    e->hash = hash;
