+/* Glyph outline cache and rasterizer. Outlines are fetched from dwrite once per font face and glyph,
+ * at a fixed reference size, and rasterized here at the needed scale. This avoids dwrite/FreeType
+ * re-hinting every glyph whenever the scale changes (e.g. while zooming). */
+#define D2D_OUTLINE_REF_EM 1024.0f
+#define D2D_OUTLINE_CACHE_BUCKETS 8192
+#define D2D_OUTLINE_CACHE_MAX_ENTRIES 65536
+
+enum d2d_outline_op_type
+{
+    D2D_OUTLINE_MOVE,
+    D2D_OUTLINE_LINE,
+    D2D_OUTLINE_CUBIC,
+};
+
+struct d2d_outline_op
+{
+    enum d2d_outline_op_type type;
+    D2D1_POINT_2F p[3];
+};
+
+struct d2d_glyph_outline
+{
+    struct d2d_glyph_outline *next;
+    IDWriteFontFace *font_face;
+    UINT16 glyph;
+    BOOL sideways;
+    size_t op_count;
+    struct d2d_outline_op *ops;
+};
+
+static struct d2d_glyph_outline *d2d_outline_cache[D2D_OUTLINE_CACHE_BUCKETS];
+static unsigned int d2d_outline_cache_count;
+static CRITICAL_SECTION d2d_outline_cache_cs;
+static CRITICAL_SECTION_DEBUG d2d_outline_cache_cs_debug =
+{
+    0, 0, &d2d_outline_cache_cs,
+    { &d2d_outline_cache_cs_debug.ProcessLocksList, &d2d_outline_cache_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": d2d_outline_cache_cs") }
+};
+static CRITICAL_SECTION d2d_outline_cache_cs = { &d2d_outline_cache_cs_debug, -1, 0, 0, 0, 0 };
+
+struct d2d_outline_sink
+{
+    IDWriteGeometrySink IDWriteGeometrySink_iface;
+    struct d2d_outline_op *ops;
+    size_t count, size;
+    BOOL failed;
+};
+
+static struct d2d_outline_sink *impl_from_IDWriteGeometrySink(IDWriteGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_outline_sink, IDWriteGeometrySink_iface);
+}
+
+static struct d2d_outline_op *d2d_outline_sink_add(struct d2d_outline_sink *sink)
+{
+    if (sink->failed)
+        return NULL;
+    if (!d2d_array_reserve((void **)&sink->ops, &sink->size, sink->count + 1, sizeof(*sink->ops)))
+    {
+        sink->failed = TRUE;
+        return NULL;
+    }
+    return &sink->ops[sink->count++];
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_outline_sink_QueryInterface(IDWriteGeometrySink *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_outline_sink_AddRef(IDWriteGeometrySink *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_outline_sink_Release(IDWriteGeometrySink *iface)
+{
+    return 1;
+}
+
+static void STDMETHODCALLTYPE d2d_outline_sink_SetFillMode(IDWriteGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+}
+
+static void STDMETHODCALLTYPE d2d_outline_sink_SetSegmentFlags(IDWriteGeometrySink *iface, D2D1_PATH_SEGMENT flags)
+{
+}
+
+static void STDMETHODCALLTYPE d2d_outline_sink_BeginFigure(IDWriteGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct d2d_outline_op *op;
+
+    if ((op = d2d_outline_sink_add(impl_from_IDWriteGeometrySink(iface))))
+    {
+        op->type = D2D_OUTLINE_MOVE;
+        op->p[0] = start;
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_outline_sink_AddLines(IDWriteGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct d2d_outline_sink *sink = impl_from_IDWriteGeometrySink(iface);
+    struct d2d_outline_op *op;
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!(op = d2d_outline_sink_add(sink)))
+            return;
+        op->type = D2D_OUTLINE_LINE;
+        op->p[0] = points[i];
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_outline_sink_AddBeziers(IDWriteGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    struct d2d_outline_sink *sink = impl_from_IDWriteGeometrySink(iface);
+    struct d2d_outline_op *op;
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!(op = d2d_outline_sink_add(sink)))
+            return;
+        op->type = D2D_OUTLINE_CUBIC;
+        op->p[0] = beziers[i].point1;
+        op->p[1] = beziers[i].point2;
+        op->p[2] = beziers[i].point3;
+    }
+}
