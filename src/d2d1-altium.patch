+/* Per-draw geometry data goes into dynamic ring buffers, instead of a new buffer per draw. */
+#define D2D_UPLOAD_BUFFER_SIZE (4 * 1024 * 1024)
+
+static HRESULT d2d_device_context_upload(struct d2d_device_context *context, UINT bind_flags,
+        const void *data, UINT size, ID3D11Buffer **buffer, UINT *offset)
+{
+    BOOL index = bind_flags == D3D11_BIND_INDEX_BUFFER;
+    ID3D11Buffer **ring = index ? &context->upload_ib : &context->upload_vb;
+    UINT *pos = index ? &context->upload_ib_pos : &context->upload_vb_pos;
+    UINT aligned = (size + 15) & ~15u;
+    D3D11_MAP map_type = D3D11_MAP_WRITE_NO_OVERWRITE;
+    D3D11_SUBRESOURCE_DATA buffer_data;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    ID3D11DeviceContext *d3d_context;
+    D3D11_BUFFER_DESC desc;
+    HRESULT hr;
+
+    desc.MiscFlags = 0;
+    desc.StructureByteStride = 0;
+    desc.BindFlags = bind_flags;
+
+    if (aligned > D2D_UPLOAD_BUFFER_SIZE)
+    {
+        desc.ByteWidth = size;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.CPUAccessFlags = 0;
+        buffer_data.pSysMem = data;
+        buffer_data.SysMemPitch = 0;
+        buffer_data.SysMemSlicePitch = 0;
+        *offset = 0;
+        return ID3D11Device1_CreateBuffer(context->d3d_device, &desc, &buffer_data, buffer);
+    }
+
+    if (!*ring)
+    {
+        desc.ByteWidth = D2D_UPLOAD_BUFFER_SIZE;
+        desc.Usage = D3D11_USAGE_DYNAMIC;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &desc, NULL, ring)))
+            return hr;
+        *pos = D2D_UPLOAD_BUFFER_SIZE;
+    }
+
+    if (*pos + aligned > D2D_UPLOAD_BUFFER_SIZE)
+    {
+        map_type = D3D11_MAP_WRITE_DISCARD;
+        *pos = 0;
+    }
+
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)*ring, 0, map_type, 0, &mapped);
+    if (SUCCEEDED(hr))
+    {
+        memcpy((BYTE *)mapped.pData + *pos, data, size);
+        ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)*ring, 0);
+    }
+    ID3D11DeviceContext_Release(d3d_context);
+    if (FAILED(hr))
+        return hr;
+
+    *offset = *pos;
+    *pos += aligned;
+    *buffer = *ring;
+    ID3D11Buffer_AddRef(*buffer);
+    return S_OK;
+}
